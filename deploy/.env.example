# ── Fleche, self-hosted ───────────────────────────────────────────────────────
#
#   cp deploy/.env.example .env
#   # set APP_URL, DB_PASSWORD and (optionally) the Telegram bot + mail below
#   docker compose up -d
#
# Migrations, the app key and the first account are handled on boot.

APP_NAME=Fleche
APP_ENV=production
APP_DEBUG=false
APP_URL=https://fleche.example.com
APP_TIMEZONE=Europe/Brussels
LOG_STACK=single,stderr

# Leave empty: generated on first boot into the storage volume.
APP_KEY=

# false = /app/register is a real 404. The first account comes from ADMIN_* or
# from the setup screen on first visit. Enable this if you want your friends to use your instance.
REGISTRATION_ENABLED=false

# First account, created once on first boot. Leave empty to use the setup screen.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

APP_PORT=80

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=fleche
DB_USERNAME=fleche
DB_PASSWORD=

REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# ── Telegram ─────────────────────────────────────────────────────────────────
# Create your own bot with @BotFather, paste its token and its username
# (without @). Users then click "Connect Telegram" in Settings. No webhook and
# no public URL needed: the Settings page fetches the bot's messages itself.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ── Mail ─────────────────────────────────────────────────────────────────────
# Needed for the morning list by email and for password resets. You can check Laravel Mail docs.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="fleche@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# The community hub lives on the cloud instance.
HUB_URL=https://fleche.io

# ── Images ───────────────────────────────────────────────────────────────────
# Rule/todo pictures. `public` stores them in the storage volume. Any other
# Laravel disk works, e.g. S3 or Cloudflare R2:
#   FILESYSTEM_DISK=s3
#   AWS_ACCESS_KEY_ID= AWS_SECRET_ACCESS_KEY= AWS_DEFAULT_REGION=auto
#   AWS_BUCKET= AWS_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#   AWS_URL=https://<public bucket url>
FILESYSTEM_DISK=public
